<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oyera Bay Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root { --main-color: #0d6efd; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('image four.jpg') center/cover no-repeat fixed;
      min-height: 100vh;
    }
    nav {
      background: var(--main-color);
      padding: 15px;
      text-align: center;
    }
    nav a {
      color: white;
      margin: 0 15px;
      text-decoration: none;
      font-weight: bold;
    }
    .hero {
      text-align: center;
      padding: 40px 20px 20px;
    }
    .hero h1 {
      color: var(--main-color);
      margin-bottom: 10px;
    }
    .cards {
      display: flex;
      justify-content: center;
      gap: 25px;
      flex-wrap: wrap;
      padding: 20px;
    }
    .card {
      width: 220px;
      background: white;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      animation: float 3s ease-in-out infinite;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card:nth-child(2) { animation-delay: 0.5s; }
    .card:nth-child(3) { animation-delay: 1s; }
    .card:hover { transform: scale(1.05); box-shadow: 0 12px 25px rgba(0,0,0,0.25); }
    .card img { width: 100%; height: 180px; object-fit: cover; }
    .card .content { padding: 20px; text-align: center; }
    .card h2 { color: var(--main-color); font-size: 1.2rem; margin-bottom: 10px; }
    .card p { color: #444; line-height: 1.5; }
    footer {
      text-align: center;
      padding: 20px;
      color: #0d6efd;
      font-weight: bold;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
  </style>
</head>
<body>
  <nav>
    <a href="index.html">Home</a>
    <a href="customer_registration.html">Customer registration</a>
    <a href="technician_registration.html">Technician registration</a>
    <a href="services.html">Services</a>
    <a href="customer_%20display.html">Customer display</a>
  </nav>

  <div class="hero">
    <h1>Welcome to Oyera Bay services</h1>
    <p>Reliable repairs, genuine parts, and friendly support.</p>
  </div>

  <div class="cards">
    <article class="card">
      <img src="image one.jpg" alt="Auto Parts" />
      <div class="content">
        <h2>Auto Repair</h2>
        <p>Professional vehicle repair services at affordable prices.</p>
      </div>
    </article>

    <article class="card">
      <img src="image three.jpg" alt="Spare Parts" />
      <div class="content">
        <h2>Spare Parts</h2>
        <p>Quality spare parts for all vehicle makes and models.</p>
      </div>
    </article>

    <article class="card">
      <img src="image two.jpg" alt="Customer Service" />
      <div class="content">
        <h2>Customer Support</h2>
        <p>Friendly support team ready to help you anytime.</p>
      </div>
    </article>
  </div>

  <footer>Home like no other</footer>
</body>
</html>
